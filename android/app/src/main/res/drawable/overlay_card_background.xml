<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الظل الخارجي -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A8B5A2B" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- الإطار الذهبي الخارجي -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D4A857"
                android:centerColor="#F5E6C8"
                android:endColor="#B8860B" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- الخلفية الكريمية الداخلية -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFBF2"
                android:centerColor="#FFF8EE"
                android:endColor="#FDF2DC" />
            <corners android:radius="23dp" />
        </shape>
    </item>

</layer-list>