<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/overlay_card_background"
        android:elevation="16dp"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- الزخرفة العلوية -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- العنوان -->

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="إنجاز الختمة"
            android:textColor="#8B5A2B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- الرقم -->

        <TextView
            android:id="@+id/totalAyahs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#2D7A4F"
            android:textSize="42sp"
            android:textStyle="bold" />

        <!-- الوصف -->

        <TextView
            android:id="@+id/weekText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#8B5A2B"
            android:textSize="16sp" />

        <!-- فاصل -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- زر الإغلاق -->

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp">

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_read_background"
                android:contentDescription="إغلاق"
                android:elevation="4dp"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>