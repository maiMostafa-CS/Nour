<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/overlay_card_background"
        android:elevation="16dp"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- ============================================ -->
        <!-- الزخرفة العلوية -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- ============================================ -->
        <!-- البسملة / زخرفة علوية -->
        <!-- ============================================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="﷽"
            android:textColor="#8B5A2B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- الآية مع سكرول قابل للتكيف حسب الطول -->
        <!-- ============================================ -->

        <com.example.islamic_app.MaxHeightScrollView
            android:id="@+id/ayahScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:fadeScrollbars="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:textColor="#3E2B1F"
                android:textSize="21sp"
                android:textStyle="bold" />

        </com.example.islamic_app.MaxHeightScrollView>

        <!-- ============================================ -->
        <!-- فاصل -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- ============================================ -->
        <!-- اسم السورة ورقم الآية -->
        <!-- ============================================ -->

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#8B5A2B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- الأزرار ثابتة دائمًا في أسفل الكارد -->
        <!-- ============================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- زر "قرأتها" -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageButton
                    android:id="@+id/readButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_read_background"
                    android:contentDescription="تمت القراءة"
                    android:elevation="4dp"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <!-- مسافة -->
            <Space
                android:layout_width="28dp"
                android:layout_height="1dp" />

            <!-- زر "لاحقًا" -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageButton
                    android:id="@+id/laterButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/btn_later_background"
                    android:contentDescription="لاحقًا"
                    android:elevation="4dp"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="#8B5A2B" />
            </FrameLayout>

        </LinearLayout>

        <!-- ============================================ -->
        <!-- الزخرفة السفلية -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

    </LinearLayout>

</FrameLayout>