<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/overlay_card_background"
        android:elevation="16dp"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- ============================================ -->
        <!-- الزخرفة العلوية -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- ============================================ -->
        <!-- البسملة / زخرفة علوية -->
        <!-- ============================================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="﷽"
            android:textColor="#8B5A2B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- الآية -->
        <!-- ============================================ -->

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="10dp"
            android:textColor="#3E2B1F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- فاصل -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

        <!-- ============================================ -->
        <!-- اسم السورة ورقم الآية -->
        <!-- ============================================ -->

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#8B5A2B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- الأزرار -->
        <!-- ============================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- زر "قرأتها" -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageButton
                    android:id="@+id/readButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/btn_read_background"
                    android:contentDescription="تمت القراءة"
                    android:elevation="4dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <!-- مسافة -->
            <Space
                android:layout_width="32dp"
                android:layout_height="1dp" />

            <!-- زر "لاحقًا" -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageButton
                    android:id="@+id/laterButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/btn_later_background"
                    android:contentDescription="لاحقًا"
                    android:elevation="4dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="#8B5A2B" />
            </FrameLayout>

        </LinearLayout>

        <!-- ============================================ -->
        <!-- الزخرفة السفلية -->
        <!-- ============================================ -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"
            android:contentDescription="@null"
            android:src="@drawable/islamic_divider" />

    </LinearLayout>

</FrameLayout>