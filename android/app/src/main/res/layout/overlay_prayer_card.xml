<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/overlay_card_background"
        android:elevation="12dp"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ================================================= -->
        <!-- Card Title -->
        <!-- ================================================= -->

<!--        <TextView-->
<!--            android:id="@+id/cardTitle"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:gravity="center"-->
<!--            android:text="آية اليوم"-->
<!--            android:textColor="#8B5A2B"-->
<!--            android:textSize="14sp"-->
<!--            android:textStyle="bold" />-->

        <!-- ================================================= -->
        <!-- Ayah -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:textColor="#3E2B1F"
            android:textSize="23sp" />

        <!-- ================================================= -->
        <!-- Surah / Ayah -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#8B5A2B"
            android:textSize="14sp" />

        <!-- ================================================= -->
        <!-- Icons -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- تمت القراءة -->

            <ImageButton
                android:id="@+id/readButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="تمت القراءة"
                android:padding="10dp"
                android:src="@drawable/ic_check"
                android:tint="#8B5A2B" />

            <!-- مسافة -->

            <Space
                android:layout_width="24dp"
                android:layout_height="1dp" />

            <!-- لاحقاً -->

            <ImageButton
                android:id="@+id/laterButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="لاحقًا"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                android:tint="#8B5A2B" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>